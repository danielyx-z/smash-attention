+/* ---- R2 direct runtime reset (SSBU_RL=1, off by default).
+ * /dev/shm/ssbu_control.bin, the contract layout (tools/mem/CONTRACTS.md):
+ *   magic 4s "SSBC", version I (=1), reset_seq I, ack_seq I, state I (0 idle, 1 requested, 2 running, 3 done,
+ *   4 error), pad I. The environment (gym_reset.py / control_block.py) increments reset_seq; this runtime notices
+ *   the new value once per presented frame (the game's own thread: display.c calls debug_mode_frame) and calls the
+ *   game's battle-start / rematch entry in-process; ack_seq is copied when the call returned, state says how.
+ * SSBU_RL_ADDR=<hex guest address> (research): the entry called, overriding the discovered default.
+ * SSBU_RL_A0..A3=<hex> (research): x0..x3 for that call. */
+typedef struct { char magic[4]; uint32_t version, reset_seq, ack_seq, state, pad; } RlCtl;   /* 24 bytes */
+static RlCtl *g_rl_ctl;
+static int g_rl_on = -1, g_rl_ready;
+static uint32_t g_rl_ack;
+static uint64_t g_rl_addr, g_rl_tpidr;
+static void *g_rl_stack;
+static uint64_t g_rl_args[4];
+static volatile uint64_t g_rl_scene;                    /* the battle scene object (x0 of its update, 0x7101581270) */
+static ImportFn g_orig_scene_update;
+static int g_rl_mode = -1;                              /* 1 = call the rematch entry directly, 2 = end then rematch (default) */
+static float g_rl_spawn[2][3]; static int g_rl_spawn_ok, g_rl_last_go;
+#define RL_SET_POS   0x710206aea0ull                     /* PostureModule__set_pos_impl(accessor, const Vector3f*) */
+#define RL_INIT_DMG  0x710200b6b0ull                     /* DamageModule__init_damage_impl(accessor, float) */
+#define RL_CLEAR_SPD 0x7102043990ull                     /* KineticModule__clear_speed_all_impl(accessor) */
+static int rl_init(void) {
+    if (g_rl_on >= 0) return g_rl_on;
+    g_rl_on = getenv("SSBU_RL") && atoi(getenv("SSBU_RL")) > 0;
+    if (!g_rl_on) return 0;
+#ifndef _WIN32
+    int fd = open("/dev/shm/ssbu_control.bin", O_RDWR | O_CREAT, 0666);
+    if (fd < 0) { printf("debug reset: cannot open /dev/shm/ssbu_control.bin: %s\n", strerror(errno)); fflush(stdout); return 0; }
+    if (ftruncate(fd, (off_t)sizeof(RlCtl)) != 0) { printf("debug reset: ftruncate: %s\n", strerror(errno)); close(fd); return 0; }
+    void *p = mmap(NULL, sizeof(RlCtl), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    close(fd);
+    if (p == MAP_FAILED) { printf("debug reset: mmap: %s\n", strerror(errno)); fflush(stdout); return 0; }
+    g_rl_ctl = (RlCtl *)p;
+    if (memcmp(g_rl_ctl->magic, "SSBC", 4) != 0) { memset(g_rl_ctl, 0, sizeof *g_rl_ctl); memcpy(g_rl_ctl->magic, "SSBC", 4); g_rl_ctl->version = 1; }
+    g_rl_ack = g_rl_ctl->reset_seq;
+    g_rl_ctl->ack_seq = g_rl_ack;
+    g_rl_ctl->state = 0;                                  /* idle: anything left in the block at startup is history */
+    {   const char *e = getenv("SSBU_RL_ADDR"), *m = getenv("SSBU_RL_MODE");
+        g_rl_addr = e && *e ? strtoull(e, NULL, 16) : 0x71014d4a20ull;    /* the rematch entry (see FINDINGS) */
+        g_rl_mode = m && *m ? atoi(m) : 2;                               /* 2 = end the match, then rematch (default) */
+        for (int i = 0; i < 4; i++) { char k[16]; snprintf(k, sizeof k, "SSBU_RL_A%d", i); const char *a = getenv(k); g_rl_args[i] = a && *a ? strtoull(a, NULL, 16) : 0; }
+        g_rl_stack = VirtualAlloc(NULL, 0x100000, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    }
+    g_rl_ready = 1;
+    printf("debug reset: R2 on: control block /dev/shm/ssbu_control.bin (seq %u), mode %d, entry %llx\n", g_rl_ack, g_rl_mode, (unsigned long long)g_rl_addr);
+#else
+    printf("debug reset: R2: not implemented in the Windows build\n");
+#endif
+    fflush(stdout);
+    return g_rl_on;
+}
+static uint64_t rl_impl(void) {
+    uint64_t inst = hook_address("_ZN3lib9SingletonIN3app14FighterManagerEE9instance_E");
+    uint64_t mgr = inst ? sr64(inst) : 0;
+    return mgr ? sr64(mgr) : 0;
+}
+static int rl_live(void) {                                  /* only a live fight: the entries/menu state exist then */
+    uint64_t impl = rl_impl(); uint8_t go = 0;
+    return impl && safe_read(impl + 0xd2, &go, 1) && go;
+}
+static void rl_scene_hook(Ctx *c, void *user) {              /* x0 = the battle scene object (see FINDINGS) */
+    (void)user;
+    g_rl_scene = c->x[0];
+    g_orig_scene_update(c);
+}
+static int rl_invoke(uint64_t addr, uint64_t a0, const char *what) {
+    if (!addr || !g_rl_stack) { printf("debug reset: no entry for %s\n", what); fflush(stdout); return 0; }
+    Ctx c; memset(&c, 0, sizeof c);
+    c.x[31] = (uint64_t)(uintptr_t)g_rl_stack + 0x100000 - 0x100;
+    c.tpidr = g_rl_tpidr;                                   /* the game thread's TLS block (captured at the match set-up) */
+    c.x[0] = a0;
+    for (int i = 1; i < 4; i++) c.x[i] = g_rl_args[i];
+    call_guest(&c, GA(addr));
+    printf("debug reset: %s (entry %llx, a0 %llx) returned %llx\n", what, (unsigned long long)addr, (unsigned long long)a0, (unsigned long long)c.x[0]);
+    fflush(stdout);
+    return 1;
+}
+static int rl_invoke_f(uint64_t addr, uint64_t a0, float f, const char *what) {
+    if (!addr || !g_rl_stack) return 0;
+    Ctx c; memset(&c, 0, sizeof c);
+    c.x[31] = (uint64_t)(uintptr_t)g_rl_stack + 0x100000 - 0x100;
+    c.tpidr = g_rl_tpidr;
+    c.x[0] = a0;
+    c.v[0].f[0] = f;
+    call_guest(&c, GA(addr));
+    printf("debug reset: %s (entry %llx) returned %llx\n", what, (unsigned long long)addr, (unsigned long long)c.x[0]);
+    fflush(stdout);
+    return 1;
+}
+static uint64_t rl_acc(int i) {
+    uint64_t impl = rl_impl();
+    if (!impl || i < 0 || i > 1) return 0;
+    uint64_t entry = rd64(impl + 0x20 + 8ull * (uint64_t)i);
+    uint64_t obj = entry ? sr64(entry + 0x4160) : 0;
+    return obj ? sr64(obj + 0x20) : 0;
+}
+static float rl_f32(uint64_t a) { uint32_t v = 0; return safe_read(a, &v, 4) ? *(float *)&v : 0.0f; }
+static void rl_capture_spawn(void) {
+    for (int i = 0; i < 2; i++) {
+        uint64_t acc = rl_acc(i), pos = acc ? sr64(acc + 0x38) : 0;
+        if (!pos) continue;
+        for (int k = 0; k < 3; k++) g_rl_spawn[i][k] = rl_f32(pos + 0x30 + 4ull * (uint64_t)k);
+    }
+    g_rl_spawn_ok = 1;
+    printf("debug reset: spawn positions captured: (%g,%g,%g) (%g,%g,%g)\n", g_rl_spawn[0][0], g_rl_spawn[0][1], g_rl_spawn[0][2],
+           g_rl_spawn[1][0], g_rl_spawn[1][1], g_rl_spawn[1][2]);
+    fflush(stdout);
+}
+static void rl_reset_fighters(void) {                     /* the rematch entry re-arms the match but keeps the fighters' state */
+    uint64_t vec = (uint64_t)(uintptr_t)g_rl_stack + 0x2000;
+    for (int i = 0; i < 2; i++) {
+        uint64_t acc = rl_acc(i);
+        if (!acc) continue;
+        rl_invoke_f(RL_INIT_DMG, acc, 0.0f, "damage -> 0");
+        rl_invoke(RL_CLEAR_SPD, acc, "clear speed");
+        if (g_rl_spawn_ok) {                              /* PostureModule__set_pos: x0 accessor, x1 &Vector3f */
+            Ctx c; memset(&c, 0, sizeof c);
+            c.x[31] = (uint64_t)(uintptr_t)g_rl_stack + 0x100000 - 0x100;
+            c.tpidr = g_rl_tpidr;
+            c.x[0] = acc; c.x[1] = vec;
+            for (int k = 0; k < 3; k++) { float f = g_rl_spawn[i][k]; uint32_t u; memcpy(&u, &f, 4); wr32(vec + 4ull * (uint64_t)k, u); }
+            call_guest(&c, GA(RL_SET_POS));
+            printf("debug reset: fighter %d -> spawn (entry %llx, acc %llx)\n", i, (unsigned long long)RL_SET_POS, (unsigned long long)acc);
+            fflush(stdout);
+        }
+    }
+}
+static uint32_t g_rl_want;
+static int g_rl_stage, g_rl_wait;                          /* stage 1: the match was ended, waiting for result mode */
+static void rl_done(int ok) {
+    g_rl_ack = g_rl_want;
+    g_rl_ctl->ack_seq = g_rl_ack; MemoryBarrier();
+    g_rl_ctl->state = ok ? 3 : 4; MemoryBarrier();
+    g_rl_stage = 0;
+    printf("debug reset: reset_seq %u done (%s), ack %u, state %u\n", g_rl_want, ok ? "returned" : "error", g_rl_ack, g_rl_ctl->state);
+    fflush(stdout);
+}
+static void rl_poll(void) {                                 /* once per presented frame, on the game thread */
+    if (!rl_init() || !g_rl_ctl) return;
+    {   /* the spawn positions of this match, read at its first ready-go (the fighters stand there then) */
+        uint64_t impl = rl_impl(); uint8_t go = 0;
+        int on = impl && safe_read(impl + 0xd2, &go, 1) && go;
+        if (on && !g_rl_last_go) rl_capture_spawn();
+        g_rl_last_go = on;
+    }
+    if (g_rl_stage == 0) {
+        uint32_t seq = g_rl_ctl->reset_seq;
+        if (seq == g_rl_ack) return;
+        g_rl_want = seq; g_rl_wait = 0;
+        g_rl_ctl->state = 2; MemoryBarrier();
+        if (!rl_live()) { printf("debug reset: refused: no live fight\n"); fflush(stdout); rl_done(0); return; }
+        if (g_rl_mode == 2 && g_rl_scene) {                  /* the game's own end-of-match path, then its rematch entry */
+            rl_invoke(0x7101585b20ull, g_rl_scene, "end match");
+            g_rl_stage = 1;
+            return;
+        }
+        {   int ok = rl_invoke(g_rl_addr, g_rl_args[0], g_rl_mode == 1 ? "rematch (direct)" : "battle start");
+            if (ok) rl_reset_fighters();
+            rl_done(ok);
+        }
+        return;
+    }
+    /* stage 1: wait until the game says result mode (impl+0xe9), at most 120 frames, then the rematch entry */
+    {   uint64_t impl = rl_impl(); uint8_t res = 0;
+        int ready = impl && safe_read(impl + 0xe9, &res, 1) && res;
+        if (ready || ++g_rl_wait > 120) {
+            printf("debug reset: result mode %s after %d frames; calling the rematch entry\n", ready ? "on" : "timeout", g_rl_wait);
+            fflush(stdout);
+            {   int ok = rl_invoke(g_rl_addr, g_rl_args[0], "rematch");
+                if (ok) rl_reset_fighters();
+                rl_done(ok);
+            }
+        }
+    }
+}
